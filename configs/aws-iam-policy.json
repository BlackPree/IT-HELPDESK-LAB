{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3LogUpload",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::helpdesk-logs-[yourname]",
        "arn:aws:s3:::helpdesk-logs-[yourname]/*"
      ]
    }
  ]
}
